# compose.yaml の設定例。`cp .env.example .env` して編集する（.env はコミットしない）。
TARGET=/Users/you/Projects/my-repo
PORT=8765
# OUT=./reading/out
# CODEINSIGHT_DATA=/Users/you/.codeinsight
# CODEINSIGHT_UID=501
# CODEINSIGHT_GID=20
# VIEWER_TOKEN=change-me-to-a-long-random-string   # 16文字以上の英数字と - _。固定すると、再起動しても同じURLで開ける
# MODEL=qwen3-coder:latest
# AI_SEND=1
